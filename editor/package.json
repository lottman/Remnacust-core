    "eslint-plugin-storybook": "10.6.6",
    "gh-pages": "6.3.0",
    "globals": "17.14.0",
    "identity-obj-proxy": "3.0.0",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
